{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "Fedora",
        "padding": {
            "top": 1,
            "left": 1
        },
        "color": {
            "1": "#a7c080",
            "2": "#83c092",
            "3": "#7fbbb3",
            "4": "#dbbc7f",
            "5": "#d3c6aa"
        }
    },
    "display": {
        "separator": " : ",
        "color": {
            "keys": "#a7c080",
            "title": "#dbbc7f"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "battery",
        "break",
        "colors"
    ]
}

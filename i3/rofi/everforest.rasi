/* ─────────────────────────────────────────────
   rofi — Everforest (flat, square)
   ───────────────────────────────────────────── */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "Iosevka Nerd Font Mono 11";
    display-drun: "apps";
    display-run: "run";
    display-window: "windows";
}

* {
    bg:      #232a2e;
    bg1:     #2d353b;
    bg2:     #3d484d;
    fg:      #d3c6aa;
    dim:     #7a8478;
    accent:  #a7c080;
    red:     #e67e80;
}

window {
    transparency: "real";
    background-color: transparent;
    location: center;
    anchor: center;
    width: 600px;
    border: 0;
}

mainbox {
    background-color: @bg;
    border-radius: 0px;
    padding: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg1;
    border-radius: 0px;
    padding: 6px 8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font: "Iosevka Nerd Font Mono 13";
}

entry {
    text-color: @fg;
    background-color: transparent;
    cursor: text;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 12;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    spacing: 2px;
}

element {
    padding: 6px 10px;
    background-color: transparent;
    text-color: @fg;
    border-radius: 0px;
}

element selected {
    background-color: @accent;
    text-color: #232a2e;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element-icon {
    size: 1.3em;
    vertical-align: 0.0;
}
